  "product_scope": {
    "objective": "Rank backbone candidates for transfer learning from class-stratified labeled samples drawn from the same target distribution as downstream training and evaluation.",
    "primary_claim": "A selector is viable only if it is competitive with the exact full linear probe for linearly separable reference heads, superior for each frozen nonlinear reference head, and competitive in end-to-end runtime.",
    "out_of_scope": [
      "deployment or covariate shift outside the sampled target distribution",
      "generic overlap calibration as an end in itself",
      "universal claims beyond the frozen tasks, backbones, heads, budgets, and class-stratified sampling design",
      "unstratified natural-prevalence or severely class-imbalanced selector samples"
    ],
    "diagnostic_only": [
      "shift-reversal stress tests",
      "generic genuine-overlap AUROC/AUPRC/calibration",
      "class-balanced pooling on the per-class-balanced Food panel"
    ]
  },
