    "development_analysis_and_runtime_authorization",
    "direct_runtime",
    "runtime_refinement_choice_then_conditional_fusion_or_guardrail",
    "immutable_development_lock",
    "future_v2_untouched_confirmation_after_new_embeddings_exist",
    "final_independent_review"
  ],
  "stop_rules": {
    "immediate": [
      "leakage",
      "A_or_B_archived_parity_mismatch",
      "LP_FULL_archived_score_parity_mismatch",
      "nondeterminism",
      "source_protocol_code_or_cache_hash_mismatch",
      "malformed_duplicate_incomplete_or_nonfinite_required_panel"
    ],
    "runtime_failure": "finish_complete_counterbalanced_block_then_stop",
    "noisy_single_regret_cell": "do_not_stop",
    "confirmation": "no_interim_outcome_driven_stop_or_redesign",
    "runner_up_after_lock": "forbidden"
  },
  "artifacts": {
    "atomic": true,
    "stage_separated": true,
    "overwrite_completed_or_stopped": false,
    "resume_requires_exact_identity": true,
    "tables": "canonical_JSONL_with_count_and_sha256_manifest",
    "output_roots_excluded_from_code_identity": true,
    "required_metadata": [
      "environment",
      "package_versions",
      "original_develop_commit",
      "followup_start_commit",
      "experiment_commit_and_dirty_status",
      "protocol_sha256",
      "explicit_source_hashes",
      "code_identity_hash",
      "seeds",
      "execution_order",
      "warmup_rows",
      "deviations",
      "prerequisite_decision_hashes"
    ]
  }
}
